# ==============================================================================
# AI RECRUITER - PRODUCTION ENVIRONMENT VARIABLES (VERCEL)
# ==============================================================================

# 1. DATABASE (PostgreSQL - Required)
# Note: For Vercel, use a hosted PostgreSQL instance (e.g. Neon, Supabase, Railway, Vercel Postgres).
# Serverless connections require sslmode=require.
DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/database_name?sslmode=require"

# 2. APPLICATION URL (Optional on Vercel, auto-detected from VERCEL_URL if omitted)
# Set this to your custom domain or Vercel production domain.
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"

# 3. AUTHENTICATION (Required)
# Secure random string used to sign user and admin JWT tokens
JWT_SECRET="your-super-secret-jwt-signing-key-minimum-32-chars-long"

# 4. EMAIL / SMTP NOTIFICATIONS (Gmail)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# 5. GOOGLE GEMINI AI (Required for resume scoring, test generation, and AI recruiter)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# 6. CLOUDFLARE R2 STORAGE (Required for resumes & candidate intro videos)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ai-recruiter"
R2_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"

# 7. STRIPE BILLING & SUBSCRIPTIONS
STRIPE_SECRET_KEY="sk_live_or_test_key"
STRIPE_WEBHOOK_SECRET="whsec_webhook_secret_from_stripe_dashboard"
STRIPE_PRO_PRICE_ID="price_1ProMonthlyId"
STRIPE_BUSINESS_PRICE_ID="price_1BusinessMonthlyId"

# 8. PLATFORM SUPER ADMIN (For accessing /platform-admin)
PLATFORM_ADMIN_EMAIL="admin@yourdomain.com"
PLATFORM_ADMIN_PASSWORD="YourSecureAdminPassword123!"

# 9. VERCEL CRON PROTECTION (Optional but recommended)
# Secret header checked by /api/cron/expire-jobs
CRON_SECRET="your-random-cron-secret-token"
