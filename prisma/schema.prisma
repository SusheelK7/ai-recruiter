generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  plan                   String    @default("free")
  emailVerified          Boolean   @default(false)
  passwordResetAt        DateTime?
  lastVerificationSentAt DateTime?
  lastPasswordResetSentAt DateTime?
  createdAt              DateTime  @default(now())
  users                  User[]
  jobs                   Job[]
  subscription           Subscription?
}

model User {
  id                     String    @id @default(cuid())
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  email                  String    @unique
  passwordHash           String
  role                   String    @default("recruiter") // Admin | Recruiter | Viewer
  emailVerified          Boolean   @default(false)
  passwordResetAt        DateTime?
  lastVerificationSentAt DateTime?
  lastPasswordResetSentAt DateTime?
  createdAt              DateTime  @default(now())
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  title           String
  description     String
  requiredSkills  Json
  experienceLevel String    @default("mid")
  expiryDate      DateTime?
  publicUrl       String    @unique
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  applications    Application[]
  test            Test?
}

model Application {
  id              String         @id @default(cuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id])
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  resumeUrl       String
  videoUrl        String?
  coverLetter     String?
  matchScore      Int?
  matchedSkills   Json?
  missingSkills   Json?
  aiReasoning     String?
  introTranscript String?
  testScore       Int?
  violationLog    Json?
  status          String         @default("test_pending")
  candidateTest   CandidateTest?
  testResult      TestResult?
  interview       Interview?
  activityLogs    ActivityLog[]
  createdAt       DateTime       @default(now())
}

model CandidateTest {
  id              String      @id @default(cuid())
  applicationId   String      @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questions       Json        // Generated MCQ questions [{ question, options, correctAnswer }]
  answers         Json?       // Candidate submitted answers { [questionIndex]: selectedOption }
  durationMinutes Int         @default(20)
  startedAt       DateTime?
  submittedAt     DateTime?
  createdAt       DateTime    @default(now())
}


model Test {
  id              String   @id @default(cuid())
  jobId           String   @unique
  job             Job      @relation(fields: [jobId], references: [id])
  questions       Json
  durationMinutes Int
  passingScore    Int?
  results         TestResult[]
}

model TestResult {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  testId        String
  test          Test        @relation(fields: [testId], references: [id])
  score         Int
  violationLog  Json?
  submittedAt   DateTime    @default(now())
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  scheduledTime DateTime?
  questions     Json?
  status        String      @default("pending")
}

model Subscription {
  id               String    @id @default(cuid())
  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id])
  plan             String    @default("free")
  stripeCustomerId String?
  renewsAt         DateTime?
}

model ActivityLog {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStage String
  newStage      String
  performedBy   String
  createdAt     DateTime    @default(now())
}